{
  "compilerOptions": {
    "sourceMap": true,
    "jsx": "react",
    "target": "ES2022",
    "module": "ESNext",
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src"]
}
